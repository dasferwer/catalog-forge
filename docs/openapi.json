              "title": "Job Id"
            }
          },
          {
            "name": "x-content-sha256",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$",
              "title": "X-Content-Sha256"
