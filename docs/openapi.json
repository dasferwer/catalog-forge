  "components": {
    "schemas": {
      "CatalogInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CatalogInput"
      },
      "ColumnMap": {
        "properties": {
          "sku": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Sku",
            "default": "sku"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "default": "name"
          },
          "price": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Price",
            "default": "price"
          },
          "stock": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Stock",
            "default": "stock"
          }
        },
        "type": "object",
        "title": "ColumnMap"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportInput": {
        "properties": {
          "catalog_id": {
            "type": "string",
            "format": "uuid",
            "title": "Catalog Id"
          },
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "jsonl",
              "json"
            ],
            "title": "Format",
            "default": "csv"
          },
          "column_map": {
            "$ref": "#/components/schemas/ColumnMap"
          },
          "delimiter": {
            "type": "string",
            "enum": [
              ",",
              ";",
              "\t"
            ],
            "title": "Delimiter",
            "default": ","
          },
          "mode": {
            "type": "string",
            "enum": [
              "upsert",
              "validate_only"
            ],
            "title": "Mode",
            "default": "upsert"
          },
          "error_policy": {
            "type": "string",
            "enum": [
              "skip",
              "reject"
            ],
            "title": "Error Policy",
            "default": "skip"
          }
        },
        "type": "object",
        "required": [
          "catalog_id"
        ],
        "title": "ImportInput"
      },
      "User": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "role"
        ],
        "title": "User"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
